{
  "compilerOptions": {
    "target": "es2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "rootDir": ".",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["main.ts", "src/**/*.ts", "prisma7.config.ts"],
  "exclude": ["node_modules", "dist"]
}
